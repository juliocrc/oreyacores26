# Copiar para keystore.properties e preencher.
# O ficheiro keystore.properties NAO vai para o repositorio (ver .gitignore).
#
# Gerar a chave (uma unica vez, guardar o .jks e as passwords em local seguro):
#   keytool -genkeypair -v -keystore orey-release.jks -alias orey \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile e relativo a pasta android-clientes/ (ou caminho absoluto).
storeFile=../orey-release.jks
storePassword=SUBSTITUIR
keyAlias=orey
keyPassword=SUBSTITUIR
