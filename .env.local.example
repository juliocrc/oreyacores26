# ─── AIS / Rastreio Marítimo ──────────────────────────────────────────────────
# Posição AIS via OpenWaters (aiscast) — snapshot HTTP por MMSI.
# Documentação: https://openwaters.io/api/ais/
# Sem token usa o tier anónimo (10 MMSI / 100 sq° e 120 pedidos/min por IP).
# Grupo de MMSI e detalhes do navio: GET https://ais.openwaters.io/v1/vessels/{mmsi}

# OpenWaters AIS — token pessoal opcional (eleva limites), em https://openwaters.io/ais/token/
OPENWATERS_AIS_TOKEN=

# MarineSIA AIS — snapshot HTTP por MMSI (GET /api/v1/vessel/{mmsi}/location/latest?key=KEY).
# Histórico (/location) requer plano premium. Registar chave em https://marinesia.com
MARINESIA_API_KEY=

# AISstream AIS — WebSocket em tempo real, chave gratuita em https://aisstream.io
AISSTREAM_API_KEY=

# AISHub — registo em https://www.aishub.net
AISHUB_USERNAME=

# MyShipTracking — plano pago em https://www.myshiptracking.com/developers
MYSHIPTRACKING_API_KEY=

# VesselFinder — plano pago em https://www.vesselfinder.com/api/docs
VESSELFINDER_API_KEY=

# MarineTraffic — plano pago em https://www.marinetraffic.com/en/p/api-services
MARINETRAFFIC_API_KEY=

# Tracking backend interno (opcional — URL do servidor MaritimeBackend próprio)
MARITIME_TRACKING_API_BASE_URL=
MARITIME_TRACKING_API_TOKEN=

# Sentry observability (frontend + backend)
SENTRY_ENABLED=true
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: upload source maps on CI/CD
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
