# Example environment variables - copy to .env and fill values
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# App
PORT=3000
NODE_ENV=development

# Shared rate limiter (server only). No configuration, missing secrets, invalid backend,
# or Redis failure DENIES protected operations (503); quota exhaustion returns 429.
# Production/preview: explicitly set backend=upstash and all four values below.
# Use the SAME namespace and secrets across replicas of an environment; use a different
# namespace for each application/staging environment. NODE_ENV/VERCEL_ENV also scopes keys.
# Provision Redis separately; these settings do not provision infrastructure.
RATE_LIMIT_BACKEND=upstash
RATE_LIMIT_NAMESPACE=oreyacores
RATE_LIMIT_KEY_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random >=32-byte KEY_SECRET, distinct from the REST token. Keys use HMAC-SHA256.
# Local development/tests ONLY: explicitly set RATE_LIMIT_BACKEND=local, namespace and
# KEY_SECRET (e.g. a development-only value). Local mode is rejected in production.
# No automatic local fallback, no disabled/allow-all mode. Redis timeout: 3 seconds.
# Windows start at the first accepted request; denied requests never refresh their TTL.
# Changing namespace/KEY_SECRET resets quotas; coordinate changes across all replicas.

# Sentry (optional)
SENTRY_DSN=

# Document delivery by email. Supply real credentials privately on the server.
# Blank credentials leave delivery unavailable; do not use dummy nonempty values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Selected outbound accounts: delegated Microsoft365 OAuth2, never SMTP_PASS.
# Server-only secrets; authorization/setup: docs/microsoft365-email.md
# Tenant/client IDs must be GUIDs. Each refresh token authorizes its exact mailbox.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_JULIO_REFRESH_TOKEN=
M365_TECNICA_REFRESH_TOKEN=
# Optional per-profile TENANT_ID / CLIENT_ID / CLIENT_SECRET override shared values:
# M365_JULIO_TENANT_ID=
# M365_JULIO_CLIENT_ID=
# M365_JULIO_CLIENT_SECRET=
# M365_TECNICA_TENANT_ID=
# M365_TECNICA_CLIENT_ID=
# M365_TECNICA_CLIENT_SECRET=

# Google Drive / OAuth
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# Rclone (if used)
RCLONE_REMOTE=remote:bucket
RCLONE_CRYPT_PASSWORD=

# Misc
JWT_SECRET=replace_me_with_secure_secret
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Example env variables — do NOT commit real secrets
# App runtime resolution order: Vercel/Neon/Postgres envs -> SUPABASE_DATABASE_URL -> DATABASE_URL -> DIRECT_URL -> legacy fallbacks
# Prisma CLI / migrations resolution order: DIRECT_URL -> Vercel/Neon/Postgres envs -> SUPABASE_DATABASE_URL -> DATABASE_URL -> legacy fallbacks
POSTGRES_URL="postgres://user:password@host:5432/app?sslmode=require"
POSTGRES_PRISMA_URL="postgres://user:password@host:5432/app?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:password@host:5432/app?sslmode=require"
VERCEL_POSTGRES_URL="postgres://user:password@host:5432/app?sslmode=require"
VERCEL_POSTGRES_PRISMA_URL="postgres://user:password@host:5432/app?sslmode=require"
NEON_DATABASE_URL="postgres://user:password@ep-...us-east-1.aws.neon.tech/neondb?sslmode=require"
SUPABASE_DATABASE_URL="postgres://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="postgres://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require"
# Optional direct connection for Prisma CLI / imports / pg_restore on Supabase
DIRECT_URL="postgres://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require"
# Which database the standalone build uses (launcher.js):
#   (unset/auto) -> uses the PostgreSQL URL above if present, otherwise SQLite (prisma/local.db)
#   postgres     -> requires a PostgreSQL URL (same database the Vercel deploy uses)
#   sqlite       -> always local SQLite, even with a PostgreSQL URL configured (offline mode)
OREY_DB_MODE=
# Forces the local SQLite file even when a PostgreSQL URL is configured
OREY_FORCE_LOCAL_DB=0
# Auth.js / Google OAuth
AUTH_SECRET="replace_with_a_long_random_secret"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="google_oauth_client_id"
AUTH_GOOGLE_SECRET="google_oauth_client_secret"
AUTH_ALLOWED_EMAILS="julio.correia@orey.com"
AUTH_ADMIN_EMAILS="julio.correia@orey.com"
# Legacy compatibility fallbacks if you still have older scripts/configs
# gestornavalpro_DATABASE_URL="postgres://..."
# GESTOR_DB="postgres://..."
# Other env values you may need
# NEXT_PUBLIC_API_URL="https://your-deployed-app.vercel.app"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"
# Official Navision PDFs: production requires Blob and a stable encryption key.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the key secret and backed up; changing it makes existing PDFs unreadable.
# INVOICE_PDF_ENCRYPTION_KEY="your_64_character_hexadecimal_secret"
# OpenWaters AIS (aiscast) — snapshot HTTP por MMSI: https://openwaters.io/api/ais/
# Sem token usa o tier anónimo; token pessoal opcional em https://openwaters.io/ais/token/
OPENWATERS_AIS_TOKEN="your_openwaters_ais_token"
# MarineSIA AIS — snapshot HTTP por MMSI: https://api.marinesia.com (GET /api/v1/vessel/{mmsi}/location/latest?key=KEY)
# Histórico (/location) requer plano premium. Registar chave em https://marinesia.com
MARINESIA_API_KEY="your_marinesia_api_key"
# AISstream (WebSocket em tempo real; chave gratuita em https://aisstream.io)
AISSTREAM_API_KEY="your_aisstream_api_key"
# AISHub (fallback HTTP snapshot; máx. 1 pedido/minuto por conta segundo a documentação)
AISHUB_USERNAME="your_aishub_username"

# Integração Equasis (consulta assistida, uma embarcação de cada vez)
EQUASIS_USERNAME="your-equasis-email@example.com"
EQUASIS_PASSWORD="your-equasis-password"
EQUASIS_BASE_URL="https://www.equasis.org/EquasisWeb/"

# Backend da aplicação Maritime_Vessel_Tracking-main
MARITIME_TRACKING_API_BASE_URL="https://maritime-backend-0521.onrender.com/api"
MARITIME_TRACKING_API_TOKEN=""

# Configuração regional base (perfil Açores por defeito)
NEXT_PUBLIC_APP_REGION_PRESET="ACORES"
NEXT_PUBLIC_APP_SLUG="oreyazores26"
NEXT_PUBLIC_APP_NAME="Orey Técnica Açores"
NEXT_PUBLIC_APP_ISSUER_NAME="Sistema Oreyazores"
NEXT_PUBLIC_APP_THEME="azores"
NEXT_PUBLIC_DEFAULT_SERVICE_STATION_CODE="ACORES"
NEXT_PUBLIC_DEFAULT_REGION_LABEL="Açores"
NEXT_PUBLIC_ICS_UID_DOMAIN="oreyazores"
NEXT_PUBLIC_APP_GEO_CENTER_LAT="38.55"
NEXT_PUBLIC_APP_GEO_CENTER_LNG="-28.2"
NEXT_PUBLIC_APP_GEO_LABEL="Açores"
NEXT_PUBLIC_APP_IVA_RATE="0.16"
APP_STORAGE_NAMESPACE="oreyazores26"
# NODE_ENV=production

# rclone / Google Drive (backups + sincronização da base de dados)
# OREY_GDRIVE_SYNC="0"  -> desliga todo o sync automático (pull/push). A app fica 100% local.
# GDRIVE_REMOTE="gdrive"
# GDRIVE_DB_PATH="OreyAcores"
# GDRIVE_BACKUPS_PATH="OreyAcores_Backups"
# GDRIVE_PRUNE_MIN_AGE_DAYS="30"
# Cifragem (ativar via CONFIGURAR_RCLONE_CRYPT.bat):
# GDRIVE_CRYPT_REMOTE="orye_crypt"
# GDRIVE_CRYPT_BACKUPS_REMOTE="orye_crypt_backups"

# SMS/WhatsApp via InfiniReach - fornecedor principal da central
INFINIREACH_API_KEY=""
INFINIREACH_FROM=""
# Audio WhatsApp: Edge TTS gratuito no servidor Node.js, sem chave Azure.
# Servico nao oficial, sem SLA; pode bloquear pedidos ou mudar sem aviso.
# O texto e enviado a Microsoft. O envio WhatsApp via InfiniReach continua separado e pode ter custo.
# Vozes portuguesas permitidas: pt-BR-AntonioNeural (padrao), pt-BR-FranciscaNeural,
# pt-PT-RaquelNeural, pt-PT-DuarteNeural e restantes vozes da lista em speech-synthesis.ts.
TTS_VOICE="pt-BR-AntonioNeural"
# Julinho, assistente de voz global (botao no canto inferior direito, Ctrl+Shift+J).
# A voz usa Edge TTS no servidor e recorre a voz nativa do navegador se falhar.
# Opcional: sobrepor a voz usada pelo Julinho (tem de ser uma voz de TTS_VOICES).
# JULINHO_VOICE="pt-PT-RaquelNeural"
# Opcional: perguntas livres respondidas por um modelo compativel com OpenAI.
# Sem chave, o Julinho responde apenas com as consultas locais a base de dados.
# JULINHO_LLM_API_KEY=""
# JULINHO_LLM_BASE_URL="https://api.openai.com/v1"
# JULINHO_LLM_MODEL="gpt-4o-mini"
# Ditado no servidor (fallback quando o tablet/dispositivo nao tem voz nativa).
# O audio so e enviado ao fornecedor quando este fallback e usado.
# Aceita OpenAI Whisper ou qualquer endpoint compativel POST /audio/transcriptions.
# Se JULINHO_STT_API_KEY estiver vazio, usa OPENAI_API_KEY, GEMINI_API_KEY ou JULINHO_LLM_API_KEY.
# JULINHO_STT_API_KEY=""
# JULINHO_STT_BASE_URL="https://api.openai.com/v1"
# Modelo: whisper-1 (OpenAI) ou gemini-2.5-flash (Gemini).
# Se vazio, usa whisper-1 com chaves OpenAI e gemini-2.5-flash com GEMINI_API_KEY.
# JULINHO_STT_MODEL="whisper-1"
# Rececao por adaptador externo: POST /api/comunicacoes/inbound
# Enviar este segredo no header x-inbound-secret; nunca o expor no cliente.
COMUNICACOES_INBOUND_SECRET=""

# WhatsApp via OpenWA/Baileys no Render Free: docs/openwa-render.md
# Requer o adaptador OpenWA no backend; estas variaveis nao instalam a integracao.
# Apenas servidor: nunca usar NEXT_PUBLIC_ para a URL/chave desta integracao.
WHATSAPP_PROVIDER="openwa"
# Preencher com a URL HTTPS real atribuida pelo Render, sem /api nem barra final.
OPENWA_BASE_URL=""
# Mesmo segredo forte de API_MASTER_KEY no Render (>=32 caracteres aleatorios).
OPENWA_API_KEY=""
OPENWA_SESSION_NAME="orey-acores"

# SMS via TextBee (https://textbee.dev) — a chave é gerida no painel TextBee
TEXTBEE_API_KEY="your_textbee_api_key"
TEXTBEE_DEVICE_ID="your_textbee_device_id"

# WhatsApp — Meta WABA Cloud API (envio real via API)
# Sem estes, as mensagens caem para link wa.me e o módulo mostra "Não configurado".
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Receção (webhook inbound) — assinatura X-Hub-Signature-256 + verificação
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="oreyazores26"

# WhatsApp via Zapier (alternativa ao WABA; email automático para 2FA/lembretes)
ZAPIER_WHATSAPP_WEBHOOK_URL=""
ZAPIER_WEBHOOK_URL=""
# Zapier MCP (assistência automatizada) e webhooks auxiliares
ZAPIER_MCP_TOKEN=""
ZAPIER_MCP_URL="https://mcp.zapier.com/api/v1/connect"
ZAPIER_SMS_WEBHOOK_URL=""
ZAPIER_ASSISTENCIA_TOKEN=""
ZAPIER_BACKUP_WEBHOOK_URL=""

# Sentry observability (frontend + backend)
SENTRY_ENABLED="true"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Optional: upload de sourcemaps/releases
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
